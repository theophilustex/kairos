  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Kairos</name>
  <summary>A lightweight, customisable calendar</summary>

  <description>
    <p>
      Kairos is a calendar for Linux desktops. It connects to any CalDAV or
      WebDAV server — Nextcloud, Radicale, Fastmail, Posteo, your own — and
      reads and writes your events there.
    </p>
    <p>Features:</p>
    <ul>
      <li>Month, week, day and agenda views</li>
      <li>Full read and write access to CalDAV/WebDAV calendars</li>
      <li>Desktop notifications driven by each event's own reminders</li>
      <li>Works offline: changes are queued and sent on the next sync</li>
      <li>Passwords stored in the system keyring, never in a config file</li>
      <li>Customisable through plain JSON settings and your own CSS</li>
    </ul>
  </description>

  <launchable type="desktop-id">org.kairos.Calendar.desktop</launchable>

  <developer id="org.kairos">
